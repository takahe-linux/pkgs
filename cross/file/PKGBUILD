# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='file'
pkgver='5.48'
pkgrel=1
pkgdesc='File type identification utility'

# Additional information...
arch=('mips' 'i586')
url='http://www.darwinsys.com/file/'
license=('custom')

# Dependency information
groups=('base' 'base-devel')
depends=('zlib' 'musl')
hostdepends=('toolchain' "${_target_triplet}-file")

# Building information
source=("https://astron.com/pub/${pkgname}/${pkgname}-${pkgver}.tar.gz")
md5sums=('423686e97f731d8c24e9cd1a22b03dec')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    ./configure --prefix="/usr" \
        --host="${_target_triplet}" \
        --build="${_local_triplet}" \
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # magic.mgc must be compiled by the matching file version
    make DESTDIR="${pkgdir}/" install \
        FILE_COMPILE=/opt/host-file/bin/file
    install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
    rmdir "${pkgdir}/usr/share/man/man5"
}

