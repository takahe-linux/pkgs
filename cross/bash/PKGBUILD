# Package information
pkgname='bash'
_basever='5.3'
_patchlevel='020'
pkgver="${_basever}.${_patchlevel}"
pkgrel=4
pkgdesc='The GNU Bourne Again shell'

# Additional information...
arch=('i586' 'mips')
url='http://www.gnu.org/software/bash/bash.html'
license=('GPL')

# Dependency information
groups=('base')
depends=('musl' 'readline')
hostdepends=('toolchain')
provides=('sh')
conflicts=('sh')

# Building information
_stripped_basever="$(echo ${_basever} | tr -d '.')"
source=("http://ftp.gnu.org/gnu/bash/bash-${_basever}.tar.gz")
for _patch in $(seq 1 ${_patchlevel}); do
    source=(${source[@]} "http://ftp.gnu.org/gnu/bash/bash-${_basever}-patches/bash${_stripped_basever}-$(printf "%03d" ${_patch})")
done
md5sums=('977c8c0c5ae6309191e7768e28ebc951'
         '71bdb280697184d2b84e31a6139cf46b'
         '5eb5abc33afe9a72c885e9adf1c7ba17'
         'f3250b36ff253a6f8ded854923705ad3'
         '9ef19ac80cb5f344ed1c4611edc49fb6'
         '4980fb99b7c1c1409329032864d37f58'
         '44101096c42ee15e5da64d5585ef1522'
         '5bf4213a691625e304048a30d90f73e0'
         'db4ec751ad30cb596c6cc648c0fca895'
         'b7f48b7a5cb506ec85038c3b89b9800d'
         '35b18828e7b1e2be011601fa1155cdc6'
         '38379e4331712cb030300bc8b8e5bdc5'
         '432cab8c7d12907377db2f09b5341b36'
         'b1306c3a7200b3da66d2b52cb9b0fa15'
         'df4d3303fadaefa824902924ce8e0b76'
         'c840c46dbafa9f0ebba00b4dea239ba3'
         '0ed56c9b7793771e7408db25d67a8168'
         'e428f09667b9a01da70c8189cad935cc'
         'ec1b2b697c721a67c9a010aed7018513'
         '943257a36854ea738eaf19a16670763c'
         '3e2e35da940784c0ed543c296540416e')


prepare() {
    cd "${srcdir}/${pkgname}-${_basever}"

    for _patch in $(seq 1 ${_patchlevel}); do
        patch -p0 -i "${srcdir}/bash${_stripped_basever}-$(printf "%03d" ${_patch})"
    done
}


build() {
    cd "${srcdir}/${pkgname}-${_basever}"

    # Setup the config.
    _bashconfig=(-DDEFAULT_PATH_VALUE=\'\"/usr/bin\"\'
                 -DSTANDARD_UTILS_PATH=\'\"/usr/bin\"\'
                 -DSYS_BASHRC=\'\"/etc/bash/bash.conf\"\'
                 -DSYS_BASH_LOGOUT=\'\"/etc/bash/bash.logout\"\')
    export CFLAGS="${CFLAGS} ${_bashconfig[@]}"

    # Fix the undetectable configure variables (during cross compiling).
    cat > config.cache << EOF
ac_cv_func_mmap_fixed_mapped=yes
ac_cv_func_strcoll_works=yes
ac_cv_func_working_mktime=yes
bash_cv_func_sigsetjmp=present
bash_cv_getcwd_malloc=yes
bash_cv_job_control_missing=present
bash_cv_printf_a_format=yes
bash_cv_sys_named_pipes=present
bash_cv_ulimit_maxfds=yes
bash_cv_under_sys_siglist=yes
bash_cv_unusable_rtsigs=no
gt_cv_int_divbyzero_sigfpe=yes
EOF

    # Build bash.
    # mkbuiltins (and friends) are built for the *host* with CC_FOR_BUILD so
    # they can run during the build. The host gcc (>=14) treats an empty
    # parameter list "()" as "takes no arguments" and implicit declarations
    # as errors, which breaks this K&R-era code ("too many arguments to
    # function 'xmalloc'; expected 0, have 1"); build the host helpers as C89.
    export CC_FOR_BUILD="gcc -std=gnu89"
    ./configure --prefix="/usr" \
        --host="${_target_triplet}" \
        --build="${_local_triplet}" \
        --with-curses \
        --without-bash-malloc \
        --enable-readline \
        --cache-file=config.cache

    make
}


check() {
    cd "${srcdir}/${pkgname}-${_basever}"

    make check
}


package() {
    cd "${srcdir}/${pkgname}-${_basever}"

    make DESTDIR="${pkgdir}/" install
    ln -s bash "${pkgdir}/usr/bin/sh"

    rm -rf "${pkgdir}/usr/share/info"
}
