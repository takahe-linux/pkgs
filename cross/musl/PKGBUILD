# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='musl'
pkgver='1.1.19'
pkgrel=2
pkgdesc="Lightweight libc implementation"

# Additional information...
arch=('i586' 'mips')
url="http://www.musl-libc.org"
license=('MIT')

# Dependency information
groups=('base-devel')
hostdepends=("${_target_triplet}-gcc-static" "${_target_triplet}-binutils")

# Building information
source=("https://musl.libc.org/releases/${pkgname}-${pkgver}.tar.gz")
md5sums=('399784355ef84d800623ef5e3f51e8b8')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # musl 1.1.19's ldso start code breaks under LTO in the final link
    # (undefined reference to '_dlstart_c'), so strip it if present.
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CFLAGS="${CFLAGS// -flto / }"

    ./configure --target="${_target_triplet}" \
                --prefix="/usr" \
                --syslibdir="/usr/lib" \
                --libdir="/usr/lib" \
                --bindir="/usr/bin" \
                --includedir="/usr/include" \
                --disable-static

    make
}


package() {
    cd "${pkgname}-${pkgver}"

    # Install musl
    make DESTDIR="${pkgdir}" install
    mkdir "${pkgdir}/usr/bin"
    ln -s /usr/lib/libc.so "${pkgdir}/usr/bin/ldd"

    # Rename all the empty static libraries to dynamic equivalents.
    for lib in "${pkgdir}/usr/lib/"*.a; do
        mv -f "${lib}" "${lib%a}so"
    done
}
