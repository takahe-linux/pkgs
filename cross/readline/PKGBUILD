# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='readline'
_basever='8.3'
_patchlevel='006'
pkgver="${_basever}.${_patchlevel}"
pkgrel=18
pkgdesc="GNU line editing library"

# Additional information...
arch=('mips' 'i586')
url="https://cnswww.cns.cwru.edu/php/chet/readline/rltop.html"
license=('GPL')

# Dependency information
depends=('ncurses' 'musl')
hostdepends=('toolchain')

# Building information
source=("https://ftp.gnu.org/gnu/readline/${pkgname}-${_basever}.tar.gz")
_stripped_basever="$(echo ${_basever} | tr -d '.')"
for _patch in $(seq 1 ${_patchlevel}); do
    source+=("https://ftp.gnu.org/gnu/readline/${pkgname}-${_basever}-patches/${pkgname}${_stripped_basever}-$(printf "%03d" "${_patch}")")
done
md5sums=('25a73bfb2a3ad7146c5e9d4408d9f6cd'
         '41a796b6dc957645deb3520f4125091a'
         '6b455153895949f29e999a19c8bcc63e'
         '4a88e7d5ed1cc290b4fcb1ae3576267f'
         '66e2392335908a6a083d08c90d9a3f04'
         '64619eab873edaf45c0c524deda09d93'
         'ff24671cbae3af9c669aaa78c58379b7')


prepare() {
    cd "${srcdir}/${pkgname}-${_basever}"

    for _patch in $(seq 1 ${_patchlevel}); do
        patch -p0 -i "${srcdir}/${pkgname}${_stripped_basever}-$(printf "%03d" "${_patch}")"
    done

    # The configure script supplied with the tarball is old; regenerate.
    autoconf
}


build() {
    cd "${srcdir}/${pkgname}-${_basever}"

    ./configure --prefix="/usr" \
        --host="${_target_triplet}" \
        --build="${_local_triplet}" \
        --enable-curses \

    make
}


package() {
    cd "${srcdir}/${pkgname}-${_basever}"

    make DESTDIR="${pkgdir}/" install
    rm -rf "${pkgdir}/usr/share/info"
    # Remove the examples as well.
    rm -rf "${pkgdir}/usr/share/readline"
}
