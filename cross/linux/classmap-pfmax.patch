Fix the SELinux classmap guard for newer address families.

The security/selinux/include/classmap.h header has a compile-time
guard that errors out when PF_MAX exceeds the number of socket classes
known to this (4.16) kernel. The build host's modern libc headers
(glibc >= 2.40) define PF_MAX=46, which trips the guard and breaks the
build of scripts/selinux/genheaders (a host-side tool compiled against
the host headers).

This mirrors the upstream change (see the commit adding the "xdp_socket"
socket class): register an xdp_socket class with the common socket
permissions and allow PF_MAX up to 46 so the modern host headers no
longer trip the #error.

diff --git a/security/selinux/include/classmap.h b/security/selinux/include/classmap.h
index 0e1c8f9d4c14..883d4f8f39f1 100644
--- a/security/selinux/include/classmap.h
+++ b/security/selinux/include/classmap.h
@@ -234,6 +234,8 @@
 	  { COMMON_SOCK_PERMS, NULL } },
 	{ "smc_socket",
 	  { COMMON_SOCK_PERMS, NULL } },
+	{ "xdp_socket",
+	  { COMMON_SOCK_PERMS, NULL } },
 	{ "infiniband_pkey",
 	  { "access", NULL } },
 	{ "infiniband_endport",
@@ -243,6 +245,6 @@
 	{ NULL }
   };
 
-#if PF_MAX > 44
+#if PF_MAX > 46
 #error New address family defined, please update secclass_map.
 #endif
