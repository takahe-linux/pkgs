# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>
#
# file's install regenerates magic.mgc with a 'file' binary and refuses to use
# any version other than the source version, so we need the same version
# available to cross compile file.
#
# It is named 'host-file' and installed under a private prefix so that it can
# coexist with the host chroot's modern file/libmagic.

# Package information
pkgname='host-file'
pkgver='5.48'
pkgrel=1
pkgdesc='Host build of file (bootstrap for the cross file package)'

# Additional information...
arch=('i686' 'x86_64')
url='http://www.darwinsys.com/file/'
license=('custom')

# Dependency information
depends=('glibc' 'zlib')
provides=("${_target_triplet}-file")

# Building information
source=("https://astron.com/pub/file/file-${pkgver}.tar.gz")
md5sums=('423686e97f731d8c24e9cd1a22b03dec')


build() {
    cd "${srcdir}/file-${pkgver}"

    ./configure --prefix="/opt/host-file" \
        --disable-shared --enable-static \
        --disable-libseccomp
    make
}


package() {
    cd "${srcdir}/file-${pkgver}"

    make DESTDIR="${pkgdir}/" install
    install -Dm644 COPYING \
        "${pkgdir}/opt/host-file/share/licenses/${pkgname}/COPYING"
    rmdir "${pkgdir}/opt/host-file/share/man/man5"
}
