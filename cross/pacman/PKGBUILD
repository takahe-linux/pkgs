# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Based off the Arch Linux PKGBUILD

# Package information
pkgname='pacman'
pkgver='7.1.0'
pkgrel=5
_srcname="pacman-v${pkgver}"
pkgdesc="Arch Linux's simple package manager"

# Additional information...
arch=('i586' 'mips' 'x86_64')
url="http://www.archlinux.org/pacman/"
license=('GPL')

# Dependency information
groups=('base' 'base-devel')
depends=('bash' 'curl' 'libarchive' 'gettext' 'xz' 'musl' 'openssl')
hostdepends=('meson' 'ninja' 'toolchain' "${_target_triplet}-pkg-config")
optdepends=('wget')

# Building information
backup=('etc/pacman.conf' 'etc/makepkg.conf')
source=("https://gitlab.archlinux.org/pacman/pacman/-/archive/v${pkgver}/${_srcname}.tar.gz"
        pacman.conf
        makepkg.conf)
md5sums=('1a795e083b120b21af088ab562aad7f4'
         '044786f82c98ca027067c63037e1fa15'
         'fefa873b52d15f08a1d32cb469ec6018')


prepare() {
    cd "${srcdir}/${_srcname}"
}


build() {
    cd "${srcdir}/${_srcname}"

    # Meson cross file: target the cross compiler via PATH.  Compiler and
    # linker flags (sysroot, -march, etc.) come from the CFLAGS/LDFLAGS
    # environment that makepkg provides.
    cat > meson-cross.txt << EOF
[binaries]
c = '${_target_triplet}-gcc'
ar = '${_target_triplet}-ar'
strip = '${_target_triplet}-strip'
pkgconfig = '${_target_triplet}-pkg-config'

[host_machine]
system = 'linux'
cpu_family = 'x86'
cpu = '${_target_arch_alias}'
endian = 'little'
EOF

    meson setup build \
        --cross-file meson-cross.txt \
        -Dprefix=/usr \
        -Dsysconfdir=/etc \
        -Dlocalstatedir=/var \
        -Ddoc=disabled \
        -Ddoxygen=disabled \
        -Di18n=false \
        -Dcurl=enabled \
        -Dcrypto=openssl \
        -Dgpgme=disabled \
        -Dfile-seccomp=disabled \
        -Dscriptlet-shell=/usr/bin/bash \
        -Dpkg-ext=.pkg.tar.gz \
        -Dsrc-ext=.src.tar.gz

    ninja -C build
}


package() {
    cd "${srcdir}/${_srcname}"

    DESTDIR="${pkgdir}/" meson install -C build --no-rebuild

    # Install the configuration files
    install -dm755 "${pkgdir}/etc"
    install -m644 "${srcdir}/pacman.conf" "${pkgdir}/etc/pacman.conf"

    # Install and update the makepkg config file
    install -m644 "${srcdir}/makepkg.conf" "${pkgdir}/etc/makepkg.conf"
    sed -i "${pkgdir}/etc/makepkg.conf" \
        -e "s|@CARCH[@]|${_target_arch}|g" \
        -e "s|@CHOST[@]|${_target_triplet}|g" \
        -e "s|@CFLAGS[@]|${_target_cflags}|g" \
        -e "s|@CPPFLAGS[@]|${_target_cppflags}|g" \
        -e "s|@LDFLAGS[@]|-Wl${_target_ldflags}|g"
}
