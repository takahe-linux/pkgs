# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='libjpeg'
_pkgname='libjpeg-turbo'
pkgver='2.0.0'
pkgrel=5
pkgdesc="JPEG image codec"

# Additional information...
arch=('mips' 'i586')
url="http://libjpeg-turbo.virtualgl.org/"
license=('custom')

# Dependency information
makedepends=('nasm' 'cmake')

# Building information
source=("http://downloads.sourceforge.net/project/${_pkgname}/${pkgver}/${_pkgname}-${pkgver}.tar.gz")
sha1sums=('fe49aea935617748c21ecbe46c986d6c1b98f39b')


build() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    mkdir -p build
    cd build
    cmake .. \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DCMAKE_INSTALL_LIBDIR="lib" \
        -DCMAKE_INSTALL_DOCDIR="share/doc/${pkgname}" \
        -DCMAKE_INSTALL_EXAMPLEDIR="share/doc/${pkgname}/examples" \
        -DWITH_JPEG8=1
    make
}


check() {
    cd "${srcdir}/${_pkgname}-${pkgver}/build"
    make test
}


package() {
    cd "${srcdir}/${_pkgname}-${pkgver}/build"

    make DESTDIR="${pkgdir}/" install
    install -d "${pkgdir}/usr/share/licenses/${pkgname}"
    ln -s -f ../../doc/libjpeg/README.md "${pkgdir}/usr/share/licenses/${pkgname}"
}
