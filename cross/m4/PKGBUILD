# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='m4'
pkgver='1.4.21'
pkgrel=22
pkgdesc="The GNU macro processor"

# Additional information...
arch=('mips' 'i586')
url="http://www.gnu.org/software/m4"
license=('GPL3')

# Dependency information
groups=('base-devel')
depends=('sh' 'musl')
makedepends=('linux-api-headers')
hostdepends=('toolchain')

# Building information
source=("https://ftp.gnu.org/gnu/m4/${pkgname}-${pkgver}.tar.xz")
md5sums=('8051eef7239b2f187791f2ab0034d6b7')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    ./configure --prefix=/usr \
        --build="${_local_triplet}" \
        --host="${_target_triplet}"
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}/" install

    # Remove the redundant charset.alias (provided by gettext).
    rm -f "${pkgdir}/usr/lib/charset.alias"
    rm -rf "${pkgdir}/usr/share/info"
}
