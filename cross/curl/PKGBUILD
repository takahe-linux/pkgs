# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='curl'
pkgver='8.22.0'
pkgrel=1
pkgdesc="An URL retrieval utility and library"

# Additional information...
arch=('mips' 'i586')
url="http://curl.haxx.se"
license=('MIT')

# Dependency information
depends=('openssl' 'musl' 'ca-certificates')
hostdepends=('toolchain' "${_target_triplet}-pkg-config")

# Building information
source=("http://curl.haxx.se/download/${pkgname}-${pkgver}.tar.gz")
md5sums=('e45b304c7c075915e72229d78de26afd')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    ./configure \
        --prefix="/usr" \
        --build="${_local_triplet}" \
        --host="${_target_triplet}" \
        --target="${_target_triplet}" \
        --mandir="/usr/share/man" \
        --disable-ldap \
        --disable-static \
        --without-libidn \
        --without-libpsl \
        --without-brotli \
        --without-zstd \
        --without-libssh2 \
        --without-nghttp2 \
        --without-ngtcp2 \
        --without-nghttp3 \
        --with-ssl \
        --with-ca-bundle="/etc/ssl/certs/ca-certificates.crt" \
        --with-ca-path="/etc/ssl/certs"
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}/" install
    install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
