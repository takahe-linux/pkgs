# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='linux-api-headers'
pkgver='7.2'
pkgrel=1
pkgdesc="Kernel headers sanitized for use in userspace, with musl patches"

# Additional information...
arch=("${_target_arch}")
url="http://www.kernel.org"
license=('GPL2')

# Dependency information
groups=('base-devel')

# Building information
source=("https://www.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz")
md5sums=('381ae4b20294dcf4b8f63f1fd1bb7017')


package() {
  cd "${srcdir}/linux-${pkgver}"

  make ARCH="${_target_arch_alias}" headers

  mkdir -p "${pkgdir}/usr"
  cp -rP usr/include "${pkgdir}/usr/"

  # Use headers from libdrm for drm support
  rm -r "${pkgdir}/usr/include/drm"

  # Clean-up unnecessary files generated during install.
  find ${pkgdir} \( -name .install -o -name '.*.cmd' \) -delete
}
