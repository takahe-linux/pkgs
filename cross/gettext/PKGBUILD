# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='gettext'
pkgver='1.0'
pkgrel=23
pkgdesc="GNU internationalization library"

# Additional information...
arch=('mips' 'i586')
url="http://www.gnu.org/software/gettext/"
license=('GPL')

# Dependency information
groups=('base-devel')
depends=('musl' 'gcc-libs')
makedepends=('linux-api-headers')
hostdepends=('toolchain')

# Building information
options=(!docs)
source=("https://ftp.gnu.org/gnu/gettext/${pkgname}-${pkgver}.tar.gz")
md5sums=('4ba57b13fc49183a9b8ef6a691571a90')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    ./configure --prefix="/usr" \
        --host="${_target_triplet}" \
        --build="${_local_triplet}" \
        --target="${_target_triplet}"
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}/" install
    rm -rf "${pkgdir}/usr/share/info"
}
