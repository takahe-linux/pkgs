# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='openssl'
_ver='3.6.4'
# use a pacman compatible version scheme
pkgver=${_ver/[a-z]/.${_ver//[0-9.]/}}
pkgrel=1
pkgdesc='The Open Source toolkit for Secure Sockets Layer and Transport Layer Security'

# Additional information...
arch=('mips' 'i586')
url='https://www.openssl.org'
license=('custom:BSD')

# Dependency information
groups=('base-devel')
depends=('zlib' 'musl')
makedepends=('linux-api-headers')
hostdepends=('perl' 'toolchain')

# Building information
options=('!makeflags')
source=("https://www.openssl.org/source/${pkgname}-${_ver}.tar.gz")
md5sums=('f771f53e0ce36d806d64e15f4d3a36d3')


prepare() {
    cd "${srcdir}/${pkgname}-${_ver}"
}


build() {
    cd "${srcdir}/${pkgname}-${_ver}"

    if [ "${_target_arch_alias}" == 'x86_64' ]; then
        openssltarget='linux-x86_64'
        optflags='enable-ec_nistp_64_gcc_128'
    else
        openssltarget='linux-generic32'
        optflags=''
    fi

    ./Configure --prefix="/usr" \
        --openssldir="/etc/ssl" \
        --libdir="lib" \
        shared zlib "${optflags}" \
        "${openssltarget}" \
        "-Wa,--noexecstack ${CFLAGS} -fPIC ${LDFLAGS}"

    make
}


package() {
    cd "${srcdir}/${pkgname}-${_ver}"

    make DESTDIR="${pkgdir}" install_sw install_ssldirs
    install -Dm0644 LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # We don't support dynamic linking, so rm the engines dir.
    rm -rf "${pkgdir}/usr/lib/engines"

    # Let ca-certificates provide an alternative c_rehash.
    rm -f "${pkgdir}/usr/bin/c_rehash"
}
