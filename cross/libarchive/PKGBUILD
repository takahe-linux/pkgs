# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='libarchive'
pkgver='3.8.9'
pkgrel=17
pkgdesc="Library for reading and writing several compression formats"

# Additional information...
arch=('i586' 'mips')
url="http://www.libarchive.org"
license=('BSD')

# Dependency information
depends=('musl' 'zlib' 'xz')
hostdepends=('toolchain')

# Building information
source=("https://github.com/libarchive/libarchive/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
md5sums=('4bcc47ebb12649fe973b11d6315d3403')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    ./configure --prefix="/usr" \
        --host="${_target_triplet}" \
        --build="${_local_triplet}" \
        --libdir="/usr/lib" \
        --bindir="/usr/bin" \
        --includedir="/usr/include" \
        --without-xml2 \
        --without-iconv \
        --without-nettle \
        --without-expat \
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}/" install

    install -D -m644 'COPYING' "${pkgdir}/usr/share/licenses/libarchive/COPYING"
}
