# Maintainer: Alastair Hughes < hobbitalastair at yandex dot com>

# Package information
pkgname='file'
pkgver='5.35'
pkgrel=1
pkgdesc='File type identification utility'

# Additional information...
arch=('i686' 'x86_64')
url='http://www.darwinsys.com/file/'
license=('custom')

# Dependency information
depends=('glibc' 'zlib')
provides=("${_target_triplet}-${pkgname}")

# Building information
source=("https://astron.com/pub/${pkgname}/${pkgname}-${pkgver}.tar.gz")
md5sums=('5f10fb45bdaffd729a572e563783b78e')


build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Link file statically against the in-tree libmagic. The host's much
    # newer libmagic.so (same SONAME; /usr/lib is read-only so it cannot be
    # displaced) is what the plain dynamic build picks up at runtime via
    # rpath, and its magic version (548) mismatches this source (535),
    # breaking the magic.mgc compile step during the build. A static
    # libmagic keeps this bootstrap 'file' hermetic against host interference.
    # Also disable the libseccomp sandbox: file 5.35 auto-enables it when the
    # host has libseccomp, and its kill-filter trips on the fakechroot syscall
    # shim during the build (SIGSYS while compiling magic.mgc).
    ./configure --prefix="/usr" --disable-shared --enable-static \
        --disable-libseccomp
    make
}


package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}/" install
    install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
    rmdir "${pkgdir}/usr/share/man/man5"
}

